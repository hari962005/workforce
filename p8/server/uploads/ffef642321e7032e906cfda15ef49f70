/* =========================================
   GLOBAL
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {

    --bg: #03070d;
    --bg2: #07101b;

    --card: rgba(10, 20, 32, 0.75);

    --text: #f4f7f9;
    --muted: #9ba9b7;

    --green: #00e6b0;
    --green-dark: #00a984;

    --purple: #8175ff;

    --border: rgba(255,255,255,0.09);

}

html {
    scroll-behavior: smooth;
}

body {

    font-family: "Inter", sans-serif;

    background:
        radial-gradient(
            circle at 80% 10%,
            rgba(0,230,176,0.09),
            transparent 30%
        ),

        radial-gradient(
            circle at 10% 80%,
            rgba(129,117,255,0.08),
            transparent 30%
        ),

        var(--bg);

    color: var(--text);

    overflow-x: hidden;

}

body::before {

    content: "";

    position: fixed;

    inset: 0;

    pointer-events: none;

    background-image:
        linear-gradient(
            rgba(255,255,255,0.025) 1px,
            transparent 1px
        ),

        linear-gradient(
            90deg,
            rgba(255,255,255,0.025) 1px,
            transparent 1px
        );

    background-size: 55px 55px;

    mask-image:
        linear-gradient(
            to bottom,
            black,
            transparent 80%
        );

    z-index: -1;

}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font-family: inherit;
}


/* =========================================
   PARTICLES
========================================= */

#particles {

    position: fixed;

    inset: 0;

    z-index: -3;

    pointer-events: none;

}


/* =========================================
   LOADER
========================================= */

#loader {

    position: fixed;

    inset: 0;

    background: #02050a;

    display: flex;

    align-items: center;

    justify-content: center;

    z-index: 9999;

    transition: opacity .7s ease;

}

.loader-content {

    text-align: center;

}

.loader-logo {

    font-family: "Space Grotesk";

    font-size: 60px;

    font-weight: 800;

    color: var(--green);

}

.loader-logo span {
    color: white;
}

.loader-line {

    width: 200px;

    height: 2px;

    background: #17212c;

    margin: 20px auto;

    overflow: hidden;

}

.loader-line div {

    height: 100%;

    width: 0;

    background: var(--green);

    animation: loading 1.8s forwards;

}

.loader-content p {

    font-size: 12px;

    color: var(--muted);

}

@keyframes loading {

    to {
        width: 100%;
    }

}



/* =========================================
   NAVBAR
========================================= */

.navbar {

    position: fixed;

    top: 0;

    left: 0;

    right: 0;

    height: 75px;

    padding: 0 5%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    background: rgba(3,7,13,.75);

    backdrop-filter: blur(18px);

    border-bottom: 1px solid var(--border);

    z-index: 100;

}

.logo {

    font-family: "Space Grotesk";

    font-size: 27px;

    font-weight: 800;

}

.logo span {

    color: var(--green);

}

.nav-menu {

    display: flex;

    gap: 30px;

}

.nav-link {

    color: #aeb8c2;

    font-size: 13px;

    position: relative;

    transition: .25s;

}

.nav-link:hover,
.nav-link.active {

    color: var(--green);

}

.nav-link.active::after {

    content: "";

    position: absolute;

    height: 2px;

    background: var(--green);

    left: 0;

    right: 0;

    bottom: -27px;

}

.resume-btn {

    padding: 10px 16px;

    border: 1px solid var(--green);

    border-radius: 8px;

    color: var(--green);

    font-size: 12px;

    transition: .25s;

}

.resume-btn:hover {

    background: var(--green);

    color: #00120e;

}

.menu-btn {

    display: none;

    background: none;

    border: none;

    color: white;

    font-size: 22px;

}


/* =========================================
   HERO
========================================= */

.hero {

    min-height: 100vh;

    width: min(1250px, 90%);

    margin: auto;

    display: grid;

    grid-template-columns: 1fr 1fr;

    align-items: center;

    gap: 60px;

    padding-top: 100px;

}

.hello {

    display: inline-flex;

    gap: 8px;

    align-items: center;

    padding: 8px 15px;

    border: 1px solid rgba(0,230,176,.5);

    border-radius: 100px;

    color: var(--green);

    font-size: 13px;

    margin-bottom: 20px;

}

.wave {

    animation: wave 1.5s infinite;

    display: inline-block;

}

@keyframes wave {

    0%,100% {
        transform: rotate(0);
    }

    50% {
        transform: rotate(20deg);
    }

}

.hero h1 {

    font-family: "Space Grotesk";

    font-size: clamp(55px, 7vw, 90px);

    line-height: 1;

    letter-spacing: -5px;

}

.hero h1 span {

    color: var(--green);

}

.hero h2 {

    margin-top: 20px;

    font-size: 25px;

}

.hero h2 span {

    color: var(--green);

}

.typing-container {

    margin-top: 20px;

    font-size: 17px;

    color: var(--muted);

}

#typing {

    color: var(--green);

    font-weight: 600;

}

.typing-cursor {

    color: var(--green);

    animation: blink .7s infinite;

}

@keyframes blink {

    50% {
        opacity: 0;
    }

}

.hero-description {

    color: var(--muted);

    line-height: 1.8;

    max-width: 650px;

    margin-top: 20px;

    font-size: 14px;

}

.hero-buttons {

    display: flex;

    gap: 12px;

    margin-top: 28px;

    flex-wrap: wrap;

}

.btn {

    display: inline-flex;

    align-items: center;

    gap: 10px;

    padding: 13px 19px;

    border-radius: 9px;

    font-size: 12px;

    font-weight: 700;

    transition: .3s;

}

.primary-btn {

    background: var(--green);

    color: #00120e;

}

.primary-btn:hover {

    transform: translateY(-3px);

    box-shadow:
        0 15px 35px
        rgba(0,230,176,.2);

}

.secondary-btn {

    border: 1px solid var(--border);

    background: rgba(255,255,255,.03);

}

.secondary-btn:hover {

    border-color: var(--green);

    color: var(--green);

    transform: translateY(-3px);

}

.social-links {

    display: flex;

    gap: 12px;

    margin-top: 25px;

}

.social-links a {

    width: 38px;

    height: 38px;

    display: grid;

    place-items: center;

    border: 1px solid var(--border);

    border-radius: 9px;

    color: var(--muted);

    transition: .25s;

}

.social-links a:hover {

    color: var(--green);

    border-color: var(--green);

    transform: translateY(-4px);

}


/* =========================================
   PROFILE
========================================= */

.hero-image-area {

    height: 600px;

    display: grid;

    place-items: center;

    position: relative;

}

.profile-wrapper {

    position: relative;

    z-index: 2;

}

.profile-ring {

    width: 390px;

    height: 390px;

    padding: 8px;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            var(--green),
            var(--purple)
        );

    box-shadow:
        0 0 50px
        rgba(0,230,176,.25);

    animation: floatProfile 5s ease-in-out infinite;

}

.profile-image {

    width: 100%;

    height: 100%;

    object-fit: cover;

    border-radius: 50%;

    display: block;

    border: 5px solid #07101a;

}

@keyframes floatProfile {

    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-15px);
    }

}

.profile-glow {

    position: absolute;

    inset: -80px;

    background:
        radial-gradient(
            circle,
            rgba(0,230,176,.18),
            transparent 65%
        );

    z-index: -1;

}

.tech-circle {

    position: absolute;

    border: 1px solid rgba(0,230,176,.15);

    border-radius: 50%;

}

.circle1 {

    width: 470px;

    height: 470px;

    animation: rotate 18s linear infinite;

}

.circle2 {

    width: 560px;

    height: 560px;

    border-color: rgba(129,117,255,.1);

    animation:
        rotate 25s linear infinite reverse;

}

@keyframes rotate {

    to {
        transform: rotate(360deg);
    }

}

.floating-card {

    position: absolute;

    background: rgba(10,20,32,.9);

    border: 1px solid var(--border);

    padding: 10px 14px;

    border-radius: 9px;

    display: flex;

    gap: 8px;

    align-items: center;

    font-size: 11px;

    box-shadow: 0 15px 30px rgba(0,0,0,.3);

    backdrop-filter: blur(10px);

    z-index: 4;

}

.floating-card i {

    color: var(--green);

}

.card-ai {

    top: 17%;

    left: 5%;

    animation: floatCard 4s infinite ease-in-out;

}

.card-python {

    bottom: 22%;

    right: 4%;

    animation: floatCard 5s infinite ease-in-out .5s;

}

.card-nlp {

    bottom: 8%;

    left: 17%;

    animation: floatCard 4.5s infinite ease-in-out 1s;

}

@keyframes floatCard {

    50% {
        transform: translateY(-12px);
    }

}


/* =========================================
   QUICK INFO
========================================= */

.quick-info {

    width: min(1250px, 90%);

    margin: -25px auto 0;

    display: grid;

    grid-template-columns:
        repeat(4,1fr);

    border: 1px solid var(--border);

    background: rgba(10,20,32,.65);

    backdrop-filter: blur(15px);

    border-radius: 15px;

    overflow: hidden;

}

.info-box {

    padding: 25px;

    display: flex;

    gap: 15px;

    align-items: center;

    border-right: 1px solid var(--border);

}

.info-box:last-child {

    border-right: none;

}

.info-box i {

    font-size: 23px;

    color: var(--green);

}

.info-box small {

    display: block;

    color: var(--muted);

    font-size: 10px;

}

.info-box strong {

    font-size: 12px;

}


/* =========================================
   SECTIONS
========================================= */

.section {

    width: min(1250px, 90%);

    margin: auto;

    padding: 130px 0 50px;

}

.section-heading {

    margin-bottom: 45px;

}

.section-label {

    color: var(--green);

    font-size: 11px;

    letter-spacing: 3px;

    font-weight: 800;

    margin-bottom: 12px;

}

.section-heading h2 {

    font-family: "Space Grotesk";

    font-size: clamp(35px, 5vw, 55px);

    letter-spacing: -2px;

}

.section-heading h2 span {

    color: var(--green);

}


/* =========================================
   ABOUT
========================================= */

.about-grid {

    display: grid;

    grid-template-columns: .9fr 1.1fr;

    gap: 40px;

}

.about-content p {

    color: var(--muted);

    font-size: 14px;

    line-height: 1.9;

    margin-bottom: 17px;

}

.about-highlight {

    display: flex;

    gap: 13px;

    align-items: center;

    padding: 18px;

    border-left: 2px solid var(--green);

    background: rgba(0,230,176,.04);

    color: #c9d2da;

    font-size: 12px;

}

.about-highlight i {

    color: var(--green);

    font-size: 20px;

}

.about-cards {

    display: grid;

    grid-template-columns: repeat(2,1fr);

    gap: 15px;

}

.about-card {

    padding: 25px;

    border: 1px solid var(--border);

    border-radius: 15px;

    background: var(--card);

    transition: .3s;

}

.about-card:hover {

    border-color: rgba(0,230,176,.4);

}

.about-card i {

    color: var(--green);

    font-size: 25px;

}

.about-card h3 {

    font-family: "Space Grotesk";

    margin: 22px 0 7px;

}

.about-card p {

    color: var(--muted);

    font-size: 12px;

}


/* =========================================
   SKILLS
========================================= */

.skills-container {

    display: contents;

    grid-template-columns: repeat(3,3fr);

    gap: 30px;

}

.skill {

    margin-bottom: 25px;

}

.skill-title {

    display: flex;

    justify-content: space-between;

    margin-bottom: 9px;

    font-size: 12px;

}

.skill-title span:last-child {

    color: var(--green);

}

.skill-bar {

    height: 7px;

    background: #111c27;

    border-radius: 100px;

    overflow: hidden;

}

.skill-bar div {

    height: 100%;

    width: 0 !important;

    background:
        linear-gradient(
            90deg,
            var(--green-dark),
            var(--green)
        );

    border-radius: inherit;

    transition: width 1.5s ease;

}

.skill-bar.animate div {

    width: var(--skill-width) !important;

}

.technology-cloud {

    margin-top: 30px;

    display: flex;

    flex-wrap: wrap;

    gap: 8px;

}

.technology-cloud span {

    padding: 8px 13px;

    border-radius: 100px;

    border: 1px solid var(--border);

    color: var(--white);

    font-size: 20px;

    transition: .25s;

}

.technology-cloud span:hover {

    color: var(--green);

    border-color: var(--green);

    transform: translateY(-3px);

}


/* =========================================
   PROJECTS
========================================= */

.projects-grid {

    display: grid;

    grid-template-columns:
        repeat(2,1fr);

    gap: 22px;

}

.project-card {

    border: 1px solid var(--border);

    border-radius: 18px;

    overflow: hidden;

    background: var(--card);

    transition: .3s;

    cursor: pointer;

}

.project-card:hover {

    border-color:
        rgba(0,230,176,.45);

}

.project-image {

    height: 240px;

    position: relative;

    overflow: hidden;

}

.geo-image {

    background:
        linear-gradient(
            rgba(0,0,0,.1),
            rgba(0,0,0,.55)
        ),
        url("https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&w=1200&q=80")
        center/cover;

}

.voice-image {

    background:
        radial-gradient(
            circle at center,
            #312c75,
            #0a1020 70%
        );

    display: grid;

    place-items: center;

}

.microphone-animation {

    width: 90px;

    height: 90px;

    border-radius: 50%;

    display: grid;

    place-items: center;

    background:
        rgba(129,117,255,.18);

    border: 1px solid
        rgba(129,117,255,.5);

    animation:
        microphonePulse 2s infinite;

}

.microphone-animation i {

    font-size: 38px;

    color: white;

}

@keyframes microphonePulse {

    50% {

        box-shadow:
            0 0 0 25px
            rgba(129,117,255,.04),
            0 0 40px
            rgba(129,117,255,.3);

    }

}

.project-category {

    position: absolute;

    top: 20px;

    left: 20px;

    font-size: 9px;

    letter-spacing: 2px;

    color: white;

    background: rgba(0,0,0,.5);

    padding: 7px 10px;

    border-radius: 100px;

    backdrop-filter: blur(8px);

}

.project-overlay {

    position: absolute;

    inset: 0;

    display: grid;

    place-items: center;

    opacity: 0;

    background: rgba(0,0,0,.55);

    transition: .3s;

}

.project-overlay i {

    width: 45px;

    height: 45px;

    display: grid;

    place-items: center;

    border-radius: 50%;

    background: var(--green);

    color: #00120e;

}

.project-card:hover .project-overlay {

    opacity: 1;

}

.project-content {

    padding: 25px;

}

.project-number {

    color: var(--green);

    font-size: 10px;

    letter-spacing: 2px;

}

.project-content h3 {

    font-family: "Space Grotesk";

    font-size: 27px;

    margin-top: 8px;

}

.project-content h4 {

    color: var(--green);

    font-size: 12px;

    margin: 5px 0 15px;

}

.project-content p {

    color: var(--muted);

    font-size: 12px;

    line-height: 1.7;

}

.project-tags {

    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    margin-top: 18px;

}

.project-tags span {

    border: 1px solid var(--border);

    border-radius: 100px;

    padding: 5px 9px;

    font-size: 9px;

    color: #c6d0d8;

}


/* =========================================
   EDUCATION
========================================= */

.education-card {

    display: flex;

    gap: 25px;

    padding: 30px;

    border: 1px solid var(--border);

    border-radius: 18px;

    background: var(--card);

}

.education-icon {

    min-width: 60px;

    height: 60px;

    display: grid;

    place-items: center;

    border-radius: 14px;

    background: rgba(0,230,176,.08);

    color: var(--green);

    font-size: 25px;

}

.education-date {

    color: var(--green);

    font-size: 10px;

    letter-spacing: 2px;

}

.education-content h3 {

    font-family: "Space Grotesk";

    font-size: 25px;

    margin-top: 7px;

}

.education-content h4 {

    color: #bdb8ff;

    font-size: 13px;

}

.education-content p {

    color: var(--muted);

    font-size: 12px;

    margin: 7px 0;

}

.cgpa {

    margin-top: 15px;

    font-size: 12px;

}

.cgpa strong {

    color: var(--green);

    font-size: 20px;

}

.cgpa span {

    color: var(--muted);

}

.courses {

    margin-top: 45px;

}

.courses > h3 {

    font-family: "Space Grotesk";

    font-size: 22px;

    margin-bottom: 20px;

}

.course-grid {

    display: grid;

    grid-template-columns: repeat(2,1fr);

    gap: 15px;

}

.course-card {

    padding: 23px;

    border: 1px solid var(--border);

    border-radius: 14px;

    background: rgba(255,255,255,.02);

}

.course-card i {

    color: var(--green);

    font-size: 20px;

}

.course-card h4 {

    font-size: 13px;

    margin-top: 17px;

}

.course-card p {

    color: var(--muted);

    font-size: 10px;

    margin-top: 5px;

}


/* =========================================
   LEADERSHIP
========================================= */

.leadership-grid {

    display: grid;

    grid-template-columns: repeat(3,1fr);

    gap: 17px;

}

.leadership-card {

    padding: 28px;

    border: 1px solid var(--border);

    border-radius: 17px;

    background: var(--card);

    transition: .3s;

}

.leadership-card:hover {

    border-color: rgba(0,230,176,.4);

}

.leadership-icon {

    width: 45px;

    height: 45px;

    display: grid;

    place-items: center;

    background: rgba(0,230,176,.07);

    color: var(--green);

    border-radius: 10px;

}

.leadership-card > span {

    display: block;

    margin-top: 25px;

    color: var(--green);

    font-size: 9px;

    letter-spacing: 2px;

}

.leadership-card h3 {

    font-family: "Space Grotesk";

    margin-top: 8px;

}

.leadership-card p {

    color: var(--muted);

    font-size: 11px;

    margin-top: 5px;

}


/* =========================================
   FRESHER SECTION
========================================= */

.fresher-section {

    width: min(1250px,90%);

    margin: 100px auto;

    padding: 80px 30px;

    text-align: center;

    border: 1px solid
        rgba(0,230,176,.2);

    border-radius: 25px;

    background:

        radial-gradient(
            circle at center,
            rgba(0,230,176,.12),
            transparent 60%
        ),

        rgba(255,255,255,.02);

}

.fresher-label {

    color: var(--green);

    letter-spacing: 3px;

    font-size: 10px;

    font-weight: 800;

}

.fresher-content h2 {

    font-family: "Space Grotesk";

    font-size: clamp(35px,5vw,60px);

    line-height: 1.1;

    margin: 15px 0;

}

.fresher-content h2 span {

    color: var(--green);

}

.fresher-content p {

    color: var(--muted);

    max-width: 700px;

    margin: auto;

    font-size: 13px;

    line-height: 1.8;

}

.fresher-content .btn {

    margin-top: 25px;

}


/* =========================================
   CONTACT
========================================= */

.contact-section {

    padding-bottom: 100px;

}

.contact-box {

    text-align: center;

    padding: 80px 30px;

}

.contact-box h2 {

    font-family: "Space Grotesk";

    font-size: clamp(35px,5vw,60px);

    line-height: 1.1;

}

.contact-box h2 span {

    color: var(--green);

}

.contact-box > p:not(.section-label) {

    color: var(--muted);

    max-width: 650px;

    margin: 20px auto;

    font-size: 13px;

}

.contact-buttons {

    display: flex;

    justify-content: center;

    gap: 12px;

    margin-top: 25px;

}


/* =========================================
   FOOTER
========================================= */

footer {

    border-top: 1px solid var(--border);

    padding: 25px 5%;

    display: flex;

    justify-content: space-between;

    align-items: center;

    color: var(--muted);

    font-size: 11px;

}

.footer-logo {

    font-family: "Space Grotesk";

    color: white;

    font-size: 18px;

    font-weight: 800;

}

.footer-logo span {

    color: var(--green);

}

footer a {

    color: var(--green);

}


/* =========================================
   MODAL
========================================= */

.modal {

    position: fixed;

    inset: 0;

    background: rgba(0,0,0,.8);

    backdrop-filter: blur(12px);

    display: flex;

    align-items: center;

    justify-content: center;

    z-index: 500;

    opacity: 0;

    visibility: hidden;

    transition: .3s;

    padding: 20px;

}

.modal.show {

    opacity: 1;

    visibility: visible;

}

.modal-content {

    width: min(600px,100%);

    padding: 40px;

    border: 1px solid
        rgba(0,230,176,.25);

    border-radius: 20px;

    background: #08111d;

    position: relative;

    transform: scale(.9);

    transition: .3s;

}

.modal.show .modal-content {

    transform: scale(1);

}

.close-modal {

    position: absolute;

    top: 15px;

    right: 18px;

    background: none;

    border: none;

    color: white;

    font-size: 30px;

    cursor: pointer;

}

#modalCategory {

    color: var(--green);

    letter-spacing: 2px;

    font-size: 9px;

}

#modalTitle {

    font-family: "Space Grotesk";

    font-size: 35px;

    margin: 10px 0;

}

#modalDescription {

    color: var(--muted);

    line-height: 1.8;

    font-size: 13px;

}


/* =========================================
   REVEAL ANIMATION
========================================= */

.reveal {

    opacity: 0;

    transform: translateY(40px);

    transition:
        opacity .8s ease,
        transform .8s ease;

}

.reveal.visible {

    opacity: 1;

    transform: translateY(0);

}


/* =========================================
   MOBILE
========================================= */

@media(max-width:900px) {

    .nav-menu {

        position: fixed;

        top: 75px;

        left: 0;

        right: 0;

        background: rgba(3,7,13,.97);

        flex-direction: column;

        padding: 25px;

        display: none;

    }

    .nav-menu.open {

        display: flex;

    }

    .nav-link.active::after {

        display: none;

    }

    .menu-btn {

        display: block;

    }

    .resume-btn {

        display: none;

    }

    .hero {

        grid-template-columns: 1fr;

        padding-top: 130px;

        text-align: center;

    }

    .hero-description {

        margin-left: auto;

        margin-right: auto;

    }

    .hero-buttons,
    .social-links {

        justify-content: center;

    }

    .hero-image-area {

        height: 500px;

    }

    .quick-info {

        grid-template-columns: repeat(2,1fr);

    }

    .info-box:nth-child(2) {

        border-right: none;

    }

    .about-grid {

        grid-template-columns: 1fr;

    }

    .skills-container {

        grid-template-columns: 1fr;

        gap: 0;

    }

    .leadership-grid {

        grid-template-columns: 1fr;

    }

}


@media(max-width:600px) {

    .hero h1 {

        font-size: 55px;

    }

    .profile-ring {

        width: 280px;

        height: 280px;

    }

    .circle1 {

        width: 340px;

        height: 340px;

    }

    .circle2 {

        width: 390px;

        height: 390px;

    }

    .floating-card {

        font-size: 9px;

    }

    .card-ai {

        left: 0;

    }

    .card-python {

        right: 0;

    }

    .quick-info {

        grid-template-columns: 1fr;

    }

    .info-box {

        border-right: none;

        border-bottom: 1px solid var(--border);

    }

    .info-box:last-child {

        border-bottom: none;

    }

    .about-cards {

        grid-template-columns: 1fr;

    }

    .projects-grid {

        grid-template-columns: 1fr;

    }

    .course-grid {

        grid-template-columns: 1fr;

    }

    .education-card {

        flex-direction: column;

    }

    footer {

        flex-direction: column;

        gap: 15px;

    }

}